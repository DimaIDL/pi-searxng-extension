# SearXNG instance URL
SEARXNG_URL=http://ub2026-mini:9098

# Save raw HTML/Markdown data (.pi/fetch-raw/) (true/false)
SAVE_RAW_DATA=true

# Tool name prefix. Default "_dev_" — применяется ко всем именам
# инструментов этого расширения, чтобы dev-версия не конфликтовала
# с действующим расширением при одновременной загрузке.
# Пример: с "_dev_" инструмент "searxng_search" становится "_dev_searxng_search".
# Пустое значение (или удалить строку) — префикс не добавляется.
SEARXNG_TOOL_PREFIX=
